# .husky/pre-push
#!/bin/sh

# Prevenir push direto para main
current_branch=$(git symbolic-ref --short HEAD)
remote="$1"

# Extrai o nome do autor do commit do ambiente, se definido pelo semantic-release
commit_author_name="$GIT_AUTHOR_NAME"

# Verifica se o commit está sendo feito pelo semantic-release
# O nome do autor pode ser personalizado na configuração do @semantic-release/git
is_semantic_release=false
if [ "$commit_author_name" = "semantic-release-bot" ]; then
  is_semantic_release=true
fi

# Se tentando push para origin/main
if [ "$remote" = "origin" ] && [ "$is_semantic_release" = "false" ] && [ "$current_branch" = "main" ]; then
  echo "ERRO: Push direto para 'main' nao e permitido!"
  echo ""
  echo "Fluxo correto:"
  echo "   1. Crie uma branch: git checkout -b feat/nova-funcionalidade"
  echo "   2. Faca commits nela"
  echo "   3. Envie para o repositorio: git push origin feat/nova-funcionalidade"
  echo "   4. Abra um Pull Request no GitHub"
  echo ""
  echo "Documentacao: https://github.com/Micael-Macedo/opalbytes-directive-components/blob/main/README.md#-estrategia-de-branches"
  exit 1
fi

echo ""
echo "==========================================="
echo "  Executando testes..."
echo "==========================================="
echo ""
npm test

if [ $? -eq 0 ]; then
  echo ""
  echo "==========================================="
  echo "  Coletando metricas..."
  echo "==========================================="
  echo ""
  npm run metrics:report
else
  echo ""
  echo "ERRO: Testes falharam. Push cancelado."
  exit 1
fi
