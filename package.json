{
  "name": "opalbytes-angular-lib",
  "version": "1.21.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:all": "ng build ngx-opalbytes-directives && ng build ngx-opalbytes-components && ng build ngx-opalbytes-services && ng build ngx-opalbytes-utils && ng build ngx-opalbytes-core && ng build ngx-opalbytes-shared && ng build ngx-opalbytes-performance",
    "build:directives": "ng build ngx-opalbytes-directives",
    "build:components": "ng build ngx-opalbytes-components",
    "build:components:cli": "npm run build:components && node scripts/copy-cli-assets.cjs",
    "cao-comp": "node projects/ngx-opalbytes-components/cli/cao-comp.cjs",
    "build:services": "ng build ngx-opalbytes-services",
    "build:utils": "ng build ngx-opalbytes-utils",
    "build:performance": "ng build ngx-opalbytes-performance",
    "build:core": "ng build ngx-opalbytes-core",
    "build:shared": "ng build ngx-opalbytes-shared",
    "build:pdf": "ng build ngx-opalbytes-feature-pdf ",
    "build:video": "ng build ngx-opalbytes-video ",
    "build:chart": "ng build ngx-opalbytes-chart ",
    "storybook": "ng run ngx-opalbytes-components:storybook",
    "build-storybook": "ng run ngx-opalbytes-components:build-storybook",
    "watch": "ng build --watch --configuration development",
    "test_watch": "ng test",
    "test": "ng test --watch=false",
    "test:components": "ng test ngx-opalbytes-components --watch=false",
    "test:video": "ng test ngx-opalbytes-video --watch=false",
    "test:chart": "ng test ngx-opalbytes-chart --watch=false",
    "test:directives": "ng test ngx-opalbytes-directives --watch=false",
    "test:utils": "ng test ngx-opalbytes-utils --watch=false",
    "test:services": "ng test ngx-opalbytes-services --watch=false",
    "test:performance": "ng test ngx-opalbytes-performance --watch=false",
    "test:coverage": "vitest run --coverage",
    "test:coverage:utils": "vitest run --coverage --project ngx-opalbytes-utils",
    "test:coverage:components": "vitest run --coverage --project ngx-opalbytes-components",
    "test:coverage:directives": "vitest run --coverage --project ngx-opalbytes-directives",
    "test:coverage:services": "vitest run --coverage --project ngx-opalbytes-services",
    "test:coverage:performance": "vitest run --coverage --project ngx-opalbytes-performance",
    "test:perf": "vitest run --reporter=verbose --outputFile=test-performance.json",
    "size": "size-limit",
    "bundlesize": "bundlesize",
    "deps:check": "depcheck",
    "deps:update": "ncu",
    "deps:update:interactive": "ncu -i",
    "test:core": "ng test ngx-opalbytes-core --watch=false",
    "test:shared": "ng test ngx-opalbytes-shared --watch=false",
    "test:pdf": "ng test ngx-opalbytes-feature-pdf --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "metrics:report": "node scripts/run-metrics.js",
    "metrics:changelog": "node scripts/add-metrics-to-changelog.js",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@9.2.0",
  "dependencies": {
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.5",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lucide/angular": "^1.17.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "jwt-decode": "^4.0.0",
    "ngx-mask": "^20.0.3",
    "ngx-webstorage": "^21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "video.js": "^8.24.0",
    "web-vitals": "^4.2.4",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "latest",
    "@angular-devkit/architect": "^0.2102.22",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-devkit/core": "^21.0.0",
    "@angular/animations": "^21.0.0",
    "@angular/build": "^21.0.1",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.0",
    "@chromatic-com/storybook": "latest",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@compodoc/compodoc": "latest",
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/angular-vite": "^10.5.10",
    "@types/node": "^20",
    "@vitest/browser-playwright": "^4.0.8",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "21.0.1",
    "bundlesize2": "^0.0.31",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.4.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "^10.5.10",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.0.0",
    "npm-check-updates": "^22.2.7",
    "playwright": "latest",
    "semantic-release": "^25.0.2",
    "size-limit": "^11.2.0",
    "storybook": "^10.5.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vite": "^8.2.2",
    "vitest": "^4.0.8"
  }
}
