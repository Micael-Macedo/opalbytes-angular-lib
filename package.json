{
  "name": "opalbytes-angular-lib",
  "version": "1.15.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:all": "ng build ngx-opalbytes-directives && ng build ngx-opalbytes-components && ng build ngx-opalbytes-services && ng build ngx-opalbytes-utils && ng build ngx-opalbytes-core-shared",
    "build:directives": "ng build ngx-opalbytes-directives",
    "build:components": "ng build ngx-opalbytes-components",
    "build:services": "ng build ngx-opalbytes-services",
    "build:utils": "ng build ngx-opalbytes-utils",
    "build:core": "ng build ngx-opalbytes-core-shared",
    "build:performance": "ng build ngx-opalbytes-performance",
    "watch": "ng build --watch --configuration development",
    "test_watch": "ng test",
    "test": "ng test --watch=false",
    "test:components": "ng test ngx-opalbytes-components --watch=false",
    "test:directives": "ng test ngx-opalbytes-directives --watch=false",
    "test:utils": "ng test ngx-opalbytes-utils --watch=false",
    "test:services": "ng test ngx-opalbytes-services --watch=false",
    "test:performance": "ng test ngx-opalbytes-performance --watch=false",
    "test:coverage": "vitest run --coverage",
    "test:coverage:utils": "vitest run --coverage --project ngx-opalbytes-utils",
    "test:coverage:components": "vitest run --coverage --project ngx-opalbytes-components",
    "test:coverage:directives": "vitest run --coverage --project ngx-opalbytes-directives",
    "test:coverage:services": "vitest run --coverage --project ngx-opalbytes-services",
    "test:coverage:performance": "vitest run --coverage --project ngx-opalbytes-performance",
    "test:perf": "vitest run --reporter=verbose --outputFile=test-performance.json",
    "size": "size-limit",
    "bundlesize": "bundlesize",
    "deps:check": "depcheck",
    "deps:update": "ncu",
    "deps:update:interactive": "ncu -i",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "metrics:report": "node scripts/run-metrics.js",
    "metrics:changelog": "node scripts/add-metrics-to-changelog.js",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@9.2.0",
  "dependencies": {
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.5",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "lucide-angular": "^0.562.0",
    "ngx-mask": "^20.0.3",
    "ngx-webstorage": "^21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@angular/build": "^21.0.1",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@vitest/coverage-v8": "^4.0.16",
    "angular-eslint": "21.0.1",
    "bundlesize2": "^0.0.31",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.4.1",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.0.0",
    "npm-check-updates": "^16.14.20",
    "semantic-release": "^25.0.2",
    "size-limit": "^11.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vitest": "^4.0.8"
  }
}
